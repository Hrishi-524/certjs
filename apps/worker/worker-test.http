@baseUrl = http://localhost:3000/api/in
@runId = {{$guid}}
@username = worker-test-{{runId}}
@email = worker-test-{{runId}}@example.com
@password = password123

### 1. Create temporary user
# @name createUser
POST {{baseUrl}}/users/temp
Content-Type: application/json

{
  "username": "{{username}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

###
@userId = {{createUser.response.body.$.user.id}}

### 2. Upload template image
# @name uploadTemplate
POST {{baseUrl}}/templates
Content-Type: multipart/form-data; boundary=----certjsworkerboundary

------certjsworkerboundary
Content-Disposition: form-data; name="name"

Worker Test Template
------certjsworkerboundary
Content-Disposition: form-data; name="width"

1200
------certjsworkerboundary
Content-Disposition: form-data; name="height"

800
------certjsworkerboundary
Content-Disposition: form-data; name="user_id"

{{userId}}
------certjsworkerboundary
Content-Disposition: form-data; name="template"; filename="template.png"
Content-Type: image/png

< ../../packages/core/inputs/template.png
------certjsworkerboundary--

###
@templateId = {{uploadTemplate.response.body.$.template.id}}

### 3. Add placeholders expected by the worker
# @name addPlaceholders
POST {{baseUrl}}/templates/{{templateId}}/placeholders
Content-Type: application/json

[
  {
    "name": "Recipient Name",
    "key": "name",
    "x": 430,
    "y": 360,
    "width": 340,
    "height": 60,
    "strategy": "shrink",
    "min_font_size": 24,
    "align": "center",
    "font_size": 48,
    "font_color": "#111111",
    "font_family": "Arial"
  }
]

### 4. Create batch job
# This creates the document row and enqueues BullMQ jobs with `{ "document_id": doc.id }`.
# @name createBatchJob
POST {{baseUrl}}/jobs
Content-Type: application/json

{
  "template_id": "{{templateId}}",
  "idempotency_key": "worker-test-{{runId}}",
  "recipients": [
    {
      "name": "Ada Lovelace"
    }
  ]
}
