{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types":["node"],
        "outDir": "./dist",
        "rootDir": ".",

        "sourceMap": true,
        "declaration": true,
        
        "paths": {
            "#app/*": ["./src/*"]
        }
    },
    "include": ["src/**/*", "drizzle.config.ts"],
    "exclude": ["node_modules", "dist", "src/test/**/*"]
}
