{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "outDir": "./dist",
        "rootDir": ".",

        "sourceMap": true,
        "declaration": true,

        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "src/test/**/*"]
}
