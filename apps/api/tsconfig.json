{
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        // "moduleResolution": "node",
        "outDir": "./dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": true,
        // "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@certjs/db": ["../../packages/db"]
        }
    },
    "include": ["src/**/*", "drizzle.config.ts"],
    "exclude": ["node_modules", "dist"]
}