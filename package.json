{
    "name": "certjs",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build:packages": "npm run build -w @certjs/db && npm run build -w @certjs/queue && npm run build -w @certjs/core",
        "build:apps": "npm run build -w @certjs/api && npm run build -w @certjs/worker",
        "build": "npm run build:packages && npm run build:apps",
        "dev:api": "npm run dev -w @certjs/api",
        "dev:worker": "npm run dev -w @certjs/worker"
    },
    "dependencies": {
        "@aws-sdk/s3-request-presigner": "^3.1073.0",
        "archiver": "^8.0.0",
        "bullmq": "^5.72.1",
        "drizzle-orm": "^0.45.1",
        "express-rate-limit": "^8.5.2",
        "google-auth-library": "^10.7.0",
        "ioredis": "5.10.1",
        "ms": "^2.1.3"
    },
    "devDependencies": {
        "@types/archiver": "^8.0.0",
        "@types/ms": "^2.1.0",
        "@types/node": "^25.9.2",
        "typescript": "5.9.3"
    }
}
