meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/dashboard/auth/signup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Test User",
    "username": "testuser",
    "email": "test@example.com",
    "password": "password123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}
