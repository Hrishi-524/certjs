@baseUrl = http://localhost:3000
@accessToken =eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIwMWE5Y2NhNi1lNzVlLTRjNWMtODEwOC1iMTVhNzE1ZmQ4NDUiLCJpYXQiOjE3ODIyNzU2NjksImV4cCI6MTc4MjI3NjU2OX0.IXUNNogXRO4yxCyA9X5gg8DsJXd1jZYeqCFiqLT-sx0
### Upload template
# @name uploadTemplate
# Response shape:
# {
#   "template_id": "...",
#   "user_id": "...",
#   "s3_key": "...",
#   "s3_url": "...",
#   "name": "...",
#   "width": 1200,
#   "height": 800,
#   "created_at": "..."
# }
POST {{baseUrl}}/api/dashboard/templates
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----certjstemplateboundary

------certjstemplateboundary
Content-Disposition: form-data; name="name"

Worker Test Template
------certjstemplateboundary
Content-Disposition: form-data; name="width"

1200
------certjstemplateboundary
Content-Disposition: form-data; name="height"

800
------certjstemplateboundary
Content-Disposition: form-data; name="template"; filename="template.png"
Content-Type: image/png

< ../../packages/core/inputs/signature.png
------certjstemplateboundary--

###
@templateId = {{uploadTemplate.response.body.$.template_id}}

### List templates
# @name listTemplates
# Response shape: array of template rows owned by current user.
GET {{baseUrl}}/api/dashboard/templates
Authorization: Bearer {{accessToken}}

### Get template by ID
# @name getTemplate
# Response shape:
# {
#   "template_id": "...",
#   "user_id": "...",
#   "s3_url": "...",
#   "name": "...",
#   "width": 1200,
#   "height": 800,
#   "created_at": "..."
# }
GET {{baseUrl}}/api/dashboard/templates/{{templateId}}
Authorization: Bearer {{accessToken}}

### Update template name
# @name updateTemplateName
# Body is currently read directly in controller as `{ "name": string }`.
PATCH {{baseUrl}}/api/dashboard/templates/{{templateId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated Worker Test Template"
}

### Add placeholders to template
# @name createPlaceholders
# Body must be an array matching CreatePlaceholdersSchema.
# Response shape: inserted placeholder rows.
POST {{baseUrl}}/api/dashboard/templates/{{templateId}}/placeholders
Authorization: Bearer {{accessToken}}
Content-Type: application/json

[
  {
    "name": "Recipient Name",
    "key": "name",
    "x": 0.4,
    "y": 0.3,
    "width": 0.2,
    "height": 0.1,
    "strategy": "shrink",
    "min_font_size": 24,
    "align": "center",
    "font_size": 48,
    "font_color": "#111111",
    "font_family": "Arial"
  },
  {
    "name": "Course Name",
    "key": "course",
    "x": 0.3,
    "y": 0.4,
    "width": 0.2,
    "height": 0.1,
    "strategy": "shrink",
    "min_font_size": 18,
    "align": "center",
    "font_size": 32,
    "font_color": "#333333",
    "font_family": "Arial"
  }
]

###
@placeholderId = {{createPlaceholders.response.body.$[0].id}}

### List placeholders for template
# @name listPlaceholders
# Response shape: array of placeholder rows for this template.
GET {{baseUrl}}/api/dashboard/templates/{{templateId}}/placeholders
Authorization: Bearer {{accessToken}}

### Update placeholder
# @name updatePlaceholder
# Body is partial PlaceholderSchema.
PUT {{baseUrl}}/api/dashboard/templates/{{templateId}}/placeholders/{{placeholderId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Recipient Full Name",
  "font_size": 44,
  "font_color": "#000000"
}

### Delete placeholder
# @name deletePlaceholder
# Expected: 204 No Content
DELETE {{baseUrl}}/api/dashboard/templates/{{templateId}}/placeholders/{{placeholderId}}
Authorization: Bearer {{accessToken}}

### Delete template
# @name deleteTemplate
# Expected: 204 No Content
DELETE {{baseUrl}}/api/dashboard/templates/{{templateId}}
Authorization: Bearer {{accessToken}}