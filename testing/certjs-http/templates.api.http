@baseUrl = http://localhost:3000/api/v1
@templateId = 48f9ba78-e33f-4eef-99cb-a95a8ac2f41c

### Upload a template
POST {{baseUrl}}/templates
Content-Type: multipart/form-data; boundary=----FormBoundary

------FormBoundary
Content-Disposition: form-data; name="template"; filename="sample.png"
Content-Type: image/png

< ./sample.png
------FormBoundary
Content-Disposition: form-data; name="name"

My Certificate Template
------FormBoundary
Content-Disposition: form-data; name="width"

1200
------FormBoundary
Content-Disposition: form-data; name="height"

800
------FormBoundary--

### Get all templates
GET {{baseUrl}}/templates
Accept: application/json

### Get template by ID
GET {{baseUrl}}/templates/{{templateId}}
Accept: application/json

### Delete template
DELETE {{baseUrl}}/templates/{{templateId}}

# ─────────────────────────────────────────
# PLACEHOLDERS
# ─────────────────────────────────────────

### Add placeholders to template
POST {{baseUrl}}/templates/{{templateId}}/placeholders
Content-Type: application/json

[
    {
        "name": "name",
        "x": 400,
        "y": 300,
        "align": "center",
        "font_size": 48,
        "font_color": "#1a1a1a",
        "font_family": "sans-serif"
    },
    {
        "name": "rank",
        "x": 400,
        "y": 380,
        "font_size": 32,
        "font_color": "#555555",
        "font_family": "sans-serif",
        "align": "center"
    }
]

### Get placeholders for template
GET {{baseUrl}}/templates/{{templateId}}/placeholders
Accept: application/json

# ─────────────────────────────────────────
# JOBS (for later)
# ─────────────────────────────────────────

### Create a batch generation job
POST {{baseUrl}}/jobs
Content-Type: application/json

{
  "template_id": "{{templateId}}",
  "webhook_url": "https://webhook.site/your-id-here",
  "recipients": [
    { "name": "Hrishi Patil", "rank": "1st" },
    { "name": "John Doe",     "rank": "2nd" },
    { "name": "Jane Smith",   "rank": "3rd" }
  ]
}

### Get job status
GET {{baseUrl}}/jobs/your-job-uuid-here
Accept: application/json